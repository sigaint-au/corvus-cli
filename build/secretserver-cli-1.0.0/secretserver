#!/usr/bin/python3
"""kubectl-style CLI for Sigaint Secret Server (/eso/v1).

Secrets work with ss_… or pat_…. Teams/projects/admin require pat_….
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request
from configparser import ConfigParser
from pathlib import Path

CONFIG_DIR = Path.home() / ".config" / "secretserver"
CONFIG_PATH = CONFIG_DIR / "config"
ENV_URL, ENV_TOKEN, ENV_PROJECT = "SS_URL", "SS_TOKEN", "SS_PROJECT"
ENV_PROJECT_ALIASES = (ENV_PROJECT, "PID")
_UUID_RE = re.compile(
    r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
)

USAGE = """\
secretserver — kubectl-style client for Sigaint Secret Server

Usage:
  secretserver <command> [resource] [name] [flags]

Auth:
  ss_…  secrets in one project (UUID)
  pat_… secrets + teams/projects/admin (name or UUID)

Commands:
  login | configure
  project [NAME]                 show/switch default project
  get    <resource> [name]
  delete <resource> [name]
  create <resource> [name]
  apply|set  secret NAME …
  reveal secret NAME [--reason …]  request reveal approval (PAT)
  approve|deny <request-id>        resolve access request (admin PAT)
  restore trash <secret-id>
  transfer team NAME --email user@x
  help

Resources (get):
  secrets secret teams team projects project
  members tokens trash users audit history requests

Examples:
  secretserver get secrets
  secretserver get secrets -l platform-team   # key, note, or custom metadata
  secretserver get secret API_KEY -o value
  secretserver get secret API_KEY -o json     # + metadata, last_accessed_*
  secretserver get secret prod/db/password -o value
  secretserver reveal secret prod_root --reason "debug #1234"
  secretserver get requests
  secretserver approve <request-id> --minutes 15
  secretserver project ios-app
  secretserver get teams
  secretserver create team Platform
  secretserver create project demo --team Platform
  secretserver get members --team Platform
  secretserver create member alice@example.com --team Platform --role member
  secretserver get tokens
  secretserver create token ci --role write
  secretserver get trash
  secretserver get history API_KEY
  secretserver get users              # global admin + PAT
  secretserver get audit --source org # global admin + PAT
  printf '%s' "$V" | secretserver apply secret KEY --from-file=-

Credentials: SS_URL SS_TOKEN SS_PROJECT or ~/.config/secretserver/config
  Custom secret metadata: set in app UI Metadata tab; CLI searches/reads only.
"""


def _env_first(*names: str) -> str:
    for n in names:
        v = os.environ.get(n)
        if v:
            return v
    return ""


def _load_config() -> dict[str, str]:
    cfg = ConfigParser()
    if CONFIG_PATH.is_file():
        cfg.read(CONFIG_PATH)
    sec = cfg["default"] if cfg.has_section("default") else {}
    return {
        "url": _env_first(ENV_URL) or sec.get("url", ""),
        "token": _env_first(ENV_TOKEN) or sec.get("token", ""),
        "project": _env_first(*ENV_PROJECT_ALIASES) or sec.get("project", ""),
    }


def _file_config() -> dict[str, str]:
    cfg = ConfigParser()
    if CONFIG_PATH.is_file():
        cfg.read(CONFIG_PATH)
    sec = cfg["default"] if cfg.has_section("default") else {}
    return {
        "url": sec.get("url", ""),
        "token": sec.get("token", ""),
        "project": sec.get("project", ""),
    }


def _save_config(url: str, token: str, project: str) -> None:
    CONFIG_DIR.mkdir(parents=True, mode=0o700, exist_ok=True)
    cfg = ConfigParser()
    cfg["default"] = {"url": url.rstrip("/"), "token": token, "project": project}
    with open(CONFIG_PATH, "w") as f:
        cfg.write(f)
    CONFIG_PATH.chmod(0o600)


def _token_kind(token: str) -> str:
    if token.startswith("ss_"):
        return "machine"
    if token.startswith("pat_"):
        return "pat"
    return "unknown"


def _require_creds() -> tuple[str, str, str, str]:
    c = _load_config()
    missing = [k for k in ("url", "token") if not c.get(k)]
    if missing:
        sys.exit(
            f"missing {', '.join(missing)}; set env or run: secretserver login"
        )
    kind = _token_kind(c["token"])
    if kind == "unknown":
        sys.exit("token must start with ss_… or pat_…")
    return c["url"].rstrip("/"), c["token"], c.get("project") or "", kind


def _require_project() -> str:
    _, _, project, kind = _require_creds()
    if not project:
        sys.exit("no project set; run: secretserver project <name> or login --project …")
    if kind == "machine" and not _UUID_RE.match(project):
        sys.exit("machine tokens require project UUID")
    return project


def _require_pat() -> tuple[str, str]:
    base, token, _, kind = _require_creds()
    if kind != "pat":
        sys.exit("this command requires a pat_… token")
    return base, token


def _http(
    method: str,
    url: str,
    *,
    token: str,
    body: dict | None = None,
    query: dict | None = None,
) -> object:
    if query:
        url += "?" + urllib.parse.urlencode(
            {k: v for k, v in query.items() if v is not None and v != ""}
        )
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(
        url,
        data=data,
        method=method,
        headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/json",
            **({"Content-Type": "application/json"} if data is not None else {}),
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            raw = resp.read()
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        err_body = e.read().decode(errors="replace")
        try:
            msg = json.loads(err_body).get("error", err_body)
        except json.JSONDecodeError:
            msg = err_body or e.reason
        sys.exit(f"HTTP {e.code}: {msg}")
    except urllib.error.URLError as e:
        sys.exit(f"request failed: {e.reason}")


def _api(
    method: str,
    path: str,
    *,
    body: dict | None = None,
    query: dict | None = None,
    pat_only: bool = False,
) -> object:
    """Call /eso/v1 path (absolute under base)."""
    base, token, _, kind = _require_creds()
    if pat_only and kind != "pat":
        sys.exit("this command requires a pat_… token")
    return _http(
        method, f"{base}/eso/v1{path}", token=token, body=body, query=query
    )


def _proj_api(
    method: str,
    path: str,
    *,
    body: dict | None = None,
    query: dict | None = None,
    project: str | None = None,
) -> object:
    """Call /eso/v1/projects/<project>/…"""
    base, token, conf_proj, kind = _require_creds()
    project = project or conf_proj
    if not project:
        sys.exit("no project set; secretserver project <name>")
    if kind == "machine" and not _UUID_RE.match(project):
        sys.exit("machine tokens require project UUID")
    proj = urllib.parse.quote(project, safe="")
    return _http(
        method,
        f"{base}/eso/v1/projects/{proj}{path}",
        token=token,
        body=body,
        query=query,
    )


def _print_json(obj: object) -> None:
    print(json.dumps(obj, indent=2, sort_keys=True, default=str))


def _print_table(headers: list[str], rows: list[list[str]]) -> None:
    cols = list(headers)
    data = [[("" if c is None else str(c)) for c in row] for row in rows]
    widths = [len(h) for h in cols]
    for row in data:
        for i, cell in enumerate(row):
            if i < len(widths):
                widths[i] = max(widths[i], min(len(cell), 48))
    print("  ".join(h.ljust(widths[i]) for i, h in enumerate(cols)))
    print("  ".join("-" * widths[i] for i in range(len(cols))))
    for row in data:
        cells = []
        for i in range(len(cols)):
            cell = row[i] if i < len(row) else ""
            if len(cell) > 48:
                cell = cell[:47] + "…"
            cells.append(cell.ljust(widths[i]))
        print("  ".join(cells))


def _trunc(s: str, n: int = 48) -> str:
    s = str(s).replace("\n", "\\n")
    return s if len(s) <= n else s[: n - 1] + "…"


def _emit(obj: object, output: str) -> None:
    if output == "json":
        _print_json(obj)
        return
    if not isinstance(obj, dict):
        _print_json(obj)
        return
    if output == "value":
        if "value" not in obj:
            sys.exit("no value field")
        sys.stdout.write(str(obj["value"]))
        if not str(obj["value"]).endswith("\n"):
            sys.stdout.write("\n")
        return
    if output == "name":
        print(obj.get("key") or obj.get("name") or obj.get("id") or "")
        return
    # table
    if "items" in obj:
        items = obj.get("items") or []
        if not items:
            print("(empty)")
            return
        sample = items[0] or {}
        if "email" in sample and "scope" in sample:
            _print_table(
                ["EMAIL", "TEAM", "TEAM_ROLE", "PROJECT", "PROJECT_ROLE"],
                [
                    [
                        it.get("email", ""),
                        it.get("team", ""),
                        it.get("team_role", ""),
                        it.get("project", ""),
                        it.get("project_role", ""),
                    ]
                    for it in items
                ],
            )
        elif "email" in sample and "is_global_admin" in sample:
            _print_table(
                ["EMAIL", "NAME", "ADMIN", "DISABLED"],
                [
                    [
                        it.get("email", ""),
                        it.get("name", ""),
                        str(bool(it.get("is_global_admin"))),
                        "yes" if it.get("disabled_at") else "",
                    ]
                    for it in items
                ],
            )
        elif "team_name" in sample and "name" in sample:
            _print_table(
                ["NAME", "TEAM", "ID"],
                [
                    [it.get("name", ""), it.get("team_name", ""), it.get("id", "")]
                    for it in items
                ],
            )
        elif "project_count" in sample or (
            "role" in sample and "name" in sample and "email" not in sample
        ):
            _print_table(
                ["NAME", "ROLE", "PROJECTS", "ID"],
                [
                    [
                        it.get("name", ""),
                        it.get("role", ""),
                        str(it.get("project_count", "")),
                        it.get("id", ""),
                    ]
                    for it in items
                ],
            )
        elif "token_prefix" in sample:
            _print_table(
                ["NAME", "PREFIX", "ROLE", "EXPIRES", "ID"],
                [
                    [
                        it.get("name", ""),
                        it.get("token_prefix", ""),
                        it.get("role", ""),
                        it.get("expires_at") or "",
                        it.get("id", ""),
                    ]
                    for it in items
                ],
            )
        elif "secret_key" in sample or "action" in sample:
            _print_table(
                ["WHEN", "ACTION", "ACTOR", "DETAIL"],
                [
                    [
                        it.get("created_at") or it.get("when_display") or "",
                        it.get("action", ""),
                        it.get("actor_email", ""),
                        it.get("secret_key")
                        or it.get("detail")
                        or it.get("summary")
                        or "",
                    ]
                    for it in items
                ],
            )
        elif "key" in sample:
            _print_table(
                ["KEY", "KIND", "NOTE", "EXPIRES"],
                [
                    [
                        it.get("key", ""),
                        it.get("kind", ""),
                        it.get("note", ""),
                        it.get("expires_at") or it.get("deleted_at") or "",
                    ]
                    for it in items
                ],
            )
        elif "email" in sample:
            _print_table(
                ["EMAIL", "NAME", "ROLE", "USER_ID"],
                [
                    [
                        it.get("email", ""),
                        it.get("name", ""),
                        it.get("role", ""),
                        it.get("user_id", ""),
                    ]
                    for it in items
                ],
            )
        else:
            # generic keys from first row
            keys = list(sample.keys())[:6]
            _print_table(
                [k.upper() for k in keys],
                [[str(it.get(k, "")) for k in keys] for it in items],
            )
        return
    # single object → field table
    rows = []
    for k, v in obj.items():
        if k == "value" and output == "table":
            v = _trunc(str(v), 64)
        if k == "token":
            # show once fully
            rows.append([k, str(v)])
        elif v is not None and not isinstance(v, (list, dict)):
            rows.append([k, str(v)])
    if rows:
        _print_table(["FIELD", "VALUE"], rows)
    else:
        _print_json(obj)


def _out(args) -> str:
    return getattr(args, "output", None) or "table"


def _resolve_project_if_needed(url: str, token: str, project: str) -> str:
    if _UUID_RE.match(project) or not token.startswith("pat_"):
        return project
    data = _http(
        "GET",
        f"{url.rstrip('/')}/eso/v1/projects",
        token=token,
        query={"name": project},
    )
    items = (data or {}).get("items") or []
    exact = [i for i in items if i.get("name") == project]
    if len(exact) == 1:
        return exact[0]["id"]
    if len(items) == 1:
        return items[0]["id"]
    if not items:
        sys.exit(f"no project named {project!r}")
    sys.exit(
        "ambiguous project; candidates: "
        + ", ".join(f"{i.get('name')}={i.get('id')}" for i in items[:8])
    )


def _read_secret_value(args: argparse.Namespace) -> str | None:
    sources = [
        args.from_file is not None,
        getattr(args, "from_env", None) is not None,
        getattr(args, "value", None) is not None,
    ]
    if sum(1 for s in sources if s) > 1:
        sys.exit("use only one of: --value, --from-file, --from-env")
    if args.from_file is not None:
        if args.from_file == "-":
            return sys.stdin.read()
        return Path(args.from_file).read_text()
    env_name = getattr(args, "from_env", None)
    if env_name is not None:
        if env_name not in os.environ:
            sys.exit(f"env {env_name!r} not set")
        return os.environ[env_name]
    if getattr(args, "value", None) is not None:
        return args.value
    return None


