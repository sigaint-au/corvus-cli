#!/usr/bin/python3
"""Minimal CLI for Sigaint Secret Server machine API (/eso/v1)."""
from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request
from configparser import ConfigParser
from pathlib import Path

CONFIG_DIR = Path.home() / ".config" / "secretserver"
CONFIG_PATH = CONFIG_DIR / "config"
ENV_URL, ENV_TOKEN, ENV_PROJECT = "SS_URL", "SS_TOKEN", "SS_PROJECT"


def _load_config() -> dict[str, str]:
    cfg = ConfigParser()
    if CONFIG_PATH.is_file():
        cfg.read(CONFIG_PATH)
    sec = cfg["default"] if cfg.has_section("default") else {}
    return {
        "url": os.environ.get(ENV_URL) or sec.get("url", ""),
        "token": os.environ.get(ENV_TOKEN) or sec.get("token", ""),
        "project": os.environ.get(ENV_PROJECT) or sec.get("project", ""),
    }


def _save_config(url: str, token: str, project: str) -> None:
    CONFIG_DIR.mkdir(parents=True, mode=0o700, exist_ok=True)
    cfg = ConfigParser()
    cfg["default"] = {"url": url, "token": token, "project": project}
    with open(CONFIG_PATH, "w") as f:
        cfg.write(f)
    CONFIG_PATH.chmod(0o600)


def _require_creds() -> tuple[str, str, str]:
    c = _load_config()
    missing = [k for k in ("url", "token", "project") if not c.get(k)]
    if missing:
        sys.exit(
            f"missing {', '.join(missing)}; set {ENV_URL}/{ENV_TOKEN}/{ENV_PROJECT} "
            f"or run: secretserver login"
        )
    return c["url"].rstrip("/"), c["token"], c["project"]


def _request(
    method: str,
    path: str,
    *,
    body: dict | None = None,
    query: dict | None = None,
) -> object:
    url, token, project = _require_creds()
    base = f"{url}/eso/v1/projects/{project}{path}"
    if query:
        base += "?" + urllib.parse.urlencode({k: v for k, v in query.items() if v is not None})
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(
        base,
        data=data,
        method=method,
        headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/json",
            **({"Content-Type": "application/json"} if data is not None else {}),
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            raw = resp.read()
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        err_body = e.read().decode(errors="replace")
        try:
            msg = json.loads(err_body).get("error", err_body)
        except json.JSONDecodeError:
            msg = err_body or e.reason
        sys.exit(f"HTTP {e.code}: {msg}")
    except urllib.error.URLError as e:
        sys.exit(f"request failed: {e.reason}")


def _print(obj: object) -> None:
    print(json.dumps(obj, indent=2, sort_keys=True))


def cmd_login(args: argparse.Namespace) -> None:
    url = args.url or os.environ.get(ENV_URL) or ""
    token = args.token or os.environ.get(ENV_TOKEN) or ""
    project = args.project or os.environ.get(ENV_PROJECT) or ""
    if not (url and token and project):
        sys.exit("login needs --url, --token, and --project (or matching env vars)")
    _save_config(url.rstrip("/"), token, project)
    # smoke: list meta (1 call proves token+project)
    try:
        _request("GET", "/secrets", query={"meta": "1"})
    except SystemExit as e:
        print(f"saved {CONFIG_PATH} but check failed: {e}", file=sys.stderr)
        sys.exit(1)
    print(f"ok: saved {CONFIG_PATH}")


def cmd_list(args: argparse.Namespace) -> None:
    q = {"meta": "1"}
    if args.q:
        q["q"] = args.q
    _print(_request("GET", "/secrets", query=q))


def cmd_get(args: argparse.Namespace) -> None:
    key = urllib.parse.quote(args.key, safe="/")
    _print(_request("GET", f"/secrets/{key}"))


def cmd_edit(args: argparse.Namespace) -> None:
    key = urllib.parse.quote(args.key, safe="/")
    body: dict = {}
    if args.value is not None:
        body["value"] = args.value
    if args.note is not None:
        body["note"] = args.note
    if args.kind is not None:
        body["kind"] = args.kind
    if args.expires_days is not None:
        body["expires_days"] = args.expires_days
    if args.clear_expires:
        body["clear_expires"] = True
    if not body:
        sys.exit("edit needs at least one of: --value, --note, --kind, --expires-days, --clear-expires")
    # value set → PUT upsert; metadata-only → PATCH existing
    method = "PUT" if "value" in body else "PATCH"
    _print(_request(method, f"/secrets/{key}", body=body))


def cmd_delete(args: argparse.Namespace) -> None:
    key = urllib.parse.quote(args.key, safe="/")
    _print(_request("DELETE", f"/secrets/{key}"))


def main(argv: list[str] | None = None) -> None:
    p = argparse.ArgumentParser(
        prog="secretserver",
        description="CLI for Sigaint Secret Server (machine token API)",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    pl = sub.add_parser("login", help="save credentials to ~/.config/secretserver/config")
    pl.add_argument("--url", help=f"base URL (or {ENV_URL})")
    pl.add_argument("--token", help=f"machine token ss_… (or {ENV_TOKEN})")
    pl.add_argument("--project", help=f"project UUID (or {ENV_PROJECT})")
    pl.set_defaults(func=cmd_login)

    pls = sub.add_parser("list", help="list secret metadata (no values)")
    pls.add_argument("-q", help="filter by key/note substring")
    pls.set_defaults(func=cmd_list)

    pg = sub.add_parser("get", help="get one secret (includes value)")
    pg.add_argument("key")
    pg.set_defaults(func=cmd_get)

    pe = sub.add_parser("edit", help="create/update a secret (--value upserts; else patch metadata)")
    pe.add_argument("key")
    pe.add_argument("--value", help="plaintext value (PUT create-or-replace)")
    pe.add_argument("--note")
    pe.add_argument("--kind", choices=("plain", "database", "certificate", "ssh", "kv"))
    pe.add_argument("--expires-days", type=int, dest="expires_days")
    pe.add_argument("--clear-expires", action="store_true", dest="clear_expires")
    pe.set_defaults(func=cmd_edit)

    pd = sub.add_parser("delete", help="soft-delete a secret")
    pd.add_argument("key")
    pd.set_defaults(func=cmd_delete)

    args = p.parse_args(argv)
    args.func(args)


if __name__ == "__main__":
    main()
