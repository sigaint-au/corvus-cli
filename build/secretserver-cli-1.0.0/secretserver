def cmd_login(args: argparse.Namespace) -> None:
    url = (args.url or _env_first(ENV_URL) or "").rstrip("/")
    token = args.token or _env_first(ENV_TOKEN) or ""
    project = args.project or _env_first(*ENV_PROJECT_ALIASES) or ""
    if not (url and token and project):
        sys.exit("login needs --url, --token, and --project")
    kind = _token_kind(token)
    if kind == "unknown":
        sys.exit("token must be ss_… or pat_…")
    if kind == "machine" and not _UUID_RE.match(project):
        sys.exit("machine tokens require project UUID")
    if kind == "pat":
        project = _resolve_project_if_needed(url, token, project)
    _save_config(url, token, project)
    try:
        _proj_api("GET", "/secrets", query={"meta": "1"})
    except SystemExit as e:
        print(f"saved but check failed: {e}", file=sys.stderr)
        sys.exit(1)
    print(f"ok: {kind} project={project}", file=sys.stderr)


def cmd_project(args: argparse.Namespace) -> None:
    name = (args.name or "").strip()
    if not name:
        c = _load_config()
        pid = c.get("project") or ""
        if not pid:
            sys.exit("no project set")
        _print_table(["PROJECT"], [[pid]])
        return
    fc = _file_config()
    url = (fc.get("url") or _env_first(ENV_URL) or "").rstrip("/")
    token = fc.get("token") or _env_first(ENV_TOKEN) or ""
    if not url or not token:
        sys.exit("login first")
    kind = _token_kind(token)
    if kind == "machine":
        if not _UUID_RE.match(name):
            sys.exit("machine tokens need project UUID")
        project = name
    else:
        project = _resolve_project_if_needed(url, token, name)
    _save_config(url, token, project)
    try:
        _proj_api("GET", "/secrets", query={"meta": "1"})
    except SystemExit as e:
        print(f"saved project={project} but check failed: {e}", file=sys.stderr)
        sys.exit(1)
    _print_table(["PROJECT", "ID"], [[name, project]])


def cmd_get(args: argparse.Namespace) -> None:
    res = (args.resource or "").lower()
    out = _out(args)
    name = args.name
    team = getattr(args, "team", None)
    q = getattr(args, "selector", None)

    if res in ("secrets",):
        _emit(_proj_api("GET", "/secrets", query={"meta": "1", "q": q}), out)
        return
    if res in ("secret",) and name:
        key = urllib.parse.quote(name, safe="/")
        try:
            _emit(_proj_api("GET", f"/secrets/{key}"), out)
        except SystemExit as e:
            msg = str(e)
            low = msg.lower()
            if "approval_required" in low or ("403" in msg and "approval" in low):
                sys.exit(
                    f"{msg}\n"
                    f"hint: request approval with:\n"
                    f'  secretserver reveal secret {name} --reason "..."'
                )
            if "forbidden" in low or "403" in msg:
                sys.exit(
                    f"{msg}\n"
                    f"hint: you lack reveal permission on this secret "
                    f"(ACL / project role). Ask a project admin."
                )
            raise
        return
    if res in ("secret", "secrets") and not name:
        sys.exit("usage: get secrets | get secret NAME")
    if res in ("requests", "request", "access-requests"):
        status = getattr(args, "status", None) or "pending"
        data = _proj_api(
            "GET",
            "/access-requests",
            query={"status": status if status != "all" else None},
        )
        if out == "json":
            _emit(data, out)
            return
        items = (data or {}).get("items") or []
        if not items:
            print("(empty)")
            return
        _print_table(
            ["ID", "REQUESTER", "SECRET", "REASON", "STATUS"],
            [
                [
                    it.get("id", ""),
                    it.get("email") or it.get("name") or "",
                    it.get("secret_key", ""),
                    it.get("reason", ""),
                    it.get("status", ""),
                ]
                for it in items
            ],
        )
        return
    if res in ("projects",):
        _emit(_api("GET", "/projects", query={"q": q or name}, pat_only=True), out)
        return
    if res in ("project",) and name:
        _emit(_api("GET", f"/projects/{urllib.parse.quote(name, safe='')}", pat_only=True), out)
        return
    if res in ("teams",):
        _emit(_api("GET", "/teams", query={"q": q or name}, pat_only=True), out)
        return
    if res in ("team",) and name:
        _emit(_api("GET", f"/teams/{urllib.parse.quote(name, safe='')}", pat_only=True), out)
        return
    if res in ("members", "member"):
        if team:
            path = f"/teams/{urllib.parse.quote(team, safe='')}/members"
            _emit(_api("GET", path, pat_only=True), out)
        else:
            path = "/members"
            _emit(_proj_api("GET", path), out)
        return
    if res in ("tokens", "token"):
        _emit(_proj_api("GET", "/tokens"), out)
        return
    if res in ("trash",):
        _emit(_proj_api("GET", "/trash"), out)
        return
    if res in ("history",) and name:
        key = urllib.parse.quote(name, safe="/")
        _emit(_proj_api("GET", f"/secrets/{key}/history"), out)
        return
    if res in ("audit",):
        source = getattr(args, "source", None) or "project"
        if source in ("org", "secret", "access") or getattr(args, "admin", False):
            if source == "project":
                source = "org"
            _emit(
                _api(
                    "GET",
                    "/admin/audit",
                    query={
                        "source": source,
                        "q": q,
                        "actor": getattr(args, "actor", None),
                        "since": getattr(args, "since", None),
                        "until": getattr(args, "until", None),
                    },
                    pat_only=True,
                ),
                out,
            )
            return
        _emit(
            _proj_api(
                "GET",
                "/audit",
                query={
                    "q": q,
                    "actor": getattr(args, "actor", None),
                    "action": getattr(args, "action", None),
                },
            ),
            out,
        )
        return
    if res in ("users", "user"):
        _emit(
            _api("GET", "/admin/users", query={"q": q or name}, pat_only=True),
            out,
        )
        return
    sys.exit(f"unknown resource {res!r}")


def cmd_delete(args: argparse.Namespace) -> None:
    res = (args.resource or "").lower()
    name = args.name
    out = _out(args)
    team = getattr(args, "team", None)
    if res in ("secret", "secrets"):
        if not name:
            sys.exit("delete secret NAME")
        key = urllib.parse.quote(name, safe="/")
        data = _proj_api("DELETE", f"/secrets/{key}")
        if isinstance(data, dict):
            data = {k: v for k, v in data.items() if k != "value"}
        _emit(data, out)
        return
    if res in ("team", "teams"):
        if not name:
            sys.exit("delete team NAME")
        _emit(
            _api("DELETE", f"/teams/{urllib.parse.quote(name, safe='')}", pat_only=True),
            out,
        )
        return
    if res in ("project", "projects"):
        if not name:
            sys.exit("delete project NAME")
        _emit(
            _api(
                "DELETE",
                f"/projects/{urllib.parse.quote(name, safe='')}",
                pat_only=True,
            ),
            out,
        )
        return
    if res in ("member", "members"):
        if not name:
            sys.exit("delete member EMAIL [--team T]")
        if team:
            path = f"/teams/{urllib.parse.quote(team, safe='')}/members/{urllib.parse.quote(name, safe='')}"
            _emit(_api("DELETE", path, pat_only=True), out)
        else:
            path = f"/members/{urllib.parse.quote(name, safe='')}"
            _emit(_proj_api("DELETE", path), out)
        return
    if res in ("token", "tokens"):
        if not name:
            sys.exit("delete token TOKEN_ID")
        _emit(_proj_api("DELETE", f"/tokens/{urllib.parse.quote(name, safe='')}"), out)
        return
    if res in ("trash",):
        if not name:
            sys.exit("delete trash SECRET_ID  (permanent purge)")
        _emit(_proj_api("DELETE", f"/trash/{urllib.parse.quote(name, safe='')}"), out)
        return
    sys.exit(f"cannot delete {res!r}")


def cmd_create(args: argparse.Namespace) -> None:
    res = (args.resource or "").lower()
    name = args.name
    out = _out(args)
    team = getattr(args, "team", None)
    role = getattr(args, "role", None)
    email = getattr(args, "email", None)

    if res in ("team", "teams"):
        if not name:
            sys.exit("create team NAME")
        _emit(_api("POST", "/teams", body={"name": name}, pat_only=True), out)
        return
    if res in ("project", "projects"):
        if not name or not team:
            sys.exit("create project NAME --team TEAM")
        path = f"/teams/{urllib.parse.quote(team, safe='')}/projects"
        _emit(_api("POST", path, body={"name": name}, pat_only=True), out)
        return
    if res in ("member", "members"):
        # name is email
        email = name or email
        if not email:
            sys.exit("create member EMAIL --role ROLE [--team T]")
        body = {"email": email, "role": role or "member"}
        if team:
            path = f"/teams/{urllib.parse.quote(team, safe='')}/members"
            _emit(_api("POST", path, body=body, pat_only=True), out)
        else:
            body["role"] = role or "read"
            _emit(_proj_api("POST", "/members", body=body), out)
        return
    if res in ("token", "tokens"):
        body = {
            "name": name or "cli",
            "role": role or "read-only",
        }
        if getattr(args, "expires_days", None) is not None:
            body["expires_days"] = args.expires_days
        data = _proj_api("POST", "/tokens", body=body)
        # always show raw token once
        if isinstance(data, dict) and data.get("token"):
            print(f"token (copy now): {data['token']}", file=sys.stderr)
        _emit(data, out)
        return
    if res in ("secret", "secrets"):
        # delegate to apply
        args.resource = "secret"
        cmd_apply(args)
        return
    sys.exit(f"cannot create {res!r}")


def cmd_apply(args: argparse.Namespace) -> None:
    res = (args.resource or "").lower()
    if res not in ("secret", "secrets"):
        sys.exit("apply secret NAME …")
    if not args.name:
        sys.exit("apply secret NAME …")
    key = urllib.parse.quote(args.name, safe="/")
    body: dict = {}
    value = _read_secret_value(args)
    if value is not None:
        body["value"] = value
    if getattr(args, "note", None) is not None:
        body["note"] = args.note
    if getattr(args, "kind", None) is not None:
        body["kind"] = args.kind
    if getattr(args, "expires_days", None) is not None:
        body["expires_days"] = args.expires_days
    if getattr(args, "clear_expires", False):
        body["clear_expires"] = True
    if not body:
        sys.exit("nothing to apply")
    method = "PUT" if "value" in body else "PATCH"
    data = _proj_api(method, f"/secrets/{key}", body=body)
    out = _out(args)
    if out == "value" and isinstance(data, dict) and "value" in data:
        _emit(data, "value")
        return
    if isinstance(data, dict):
        data = {k: v for k, v in data.items() if k != "value"}
        data["ok"] = data.get("ok", True)
        data["key"] = data.get("key") or args.name
    _emit(data, out)


def cmd_restore(args: argparse.Namespace) -> None:
    if (args.resource or "").lower() not in ("trash",):
        sys.exit("restore trash SECRET_ID")
    if not args.name:
        sys.exit("restore trash SECRET_ID")
    _emit(
        _proj_api(
            "POST",
            f"/trash/{urllib.parse.quote(args.name, safe='')}/restore",
            body={},
        ),
        _out(args),
    )


def cmd_reveal(args: argparse.Namespace) -> None:
    """Request approval to reveal a secret (or print if already allowed)."""
    res = (args.resource or "secret").lower()
    name = args.name
    if res not in ("secret", "secrets") or not name:
        sys.exit("usage: reveal secret NAME [--reason …]")
    key = urllib.parse.quote(name, safe="/")
    reason = (getattr(args, "reason", None) or "").strip()
    out = _out(args)
    # Try read first — if open/admin/granted, just print value when -o value
    try:
        data = _proj_api("GET", f"/secrets/{key}")
        if out == "value" and isinstance(data, dict) and "value" in data:
            _emit(data, "value")
            return
        if out == "json":
            _emit(data, out)
            return
        print(f"You can already reveal {name}.")
        if isinstance(data, dict) and data.get("value") is not None and out == "table":
            print("(use: get secret NAME -o value)")
        return
    except SystemExit as e:
        msg = str(e)
        low = msg.lower()
        if "forbidden" in low and "approval" not in low:
            sys.exit(
                f"{msg}\n"
                f"hint: ACL denies reveal; ask a project admin for permission."
            )
        if "403" not in msg and "approval" not in low:
            raise
    body = {"reason": reason} if reason else {}
    data = _proj_api("POST", f"/secrets/{key}/access-request", body=body or None)
    if out == "json":
        _emit(data, out)
        return
    print(
        (data or {}).get("message")
        or "Access request submitted. You'll be notified when approved."
    )


def cmd_approve(args: argparse.Namespace) -> None:
    req_id = (args.request_id or args.name or "").strip()
    if not req_id:
        sys.exit("usage: approve <request-id> [--minutes 15]")
    # Must match server REVEAL_ACCESS_GRANT_CHOICES (15, 60, 240, 1440)
    allowed = (15, 60, 240, 1440)
    minutes = int(getattr(args, "minutes", None) or 15)
    if minutes not in allowed:
        sys.exit(
            f"--minutes must be one of {', '.join(str(m) for m in allowed)} "
            f"(got {minutes})"
        )
    body = {"minutes": minutes}
    data = _proj_api("POST", f"/access-requests/{req_id}/approve", body=body)
    out = _out(args)
    if out == "json":
        _emit(data, out)
        return
    print((data or {}).get("message") or f"Approved request {req_id}.")


def cmd_deny(args: argparse.Namespace) -> None:
    req_id = (args.request_id or args.name or "").strip()
    if not req_id:
        sys.exit("usage: deny <request-id>")
    data = _proj_api("POST", f"/access-requests/{req_id}/deny", body={})
    out = _out(args)
    if out == "json":
        _emit(data, out)
        return
    print((data or {}).get("message") or f"Denied request {req_id}.")


def cmd_transfer(args: argparse.Namespace) -> None:
    if (args.resource or "").lower() not in ("team", "teams"):
        sys.exit("transfer team NAME --email user@x")
    if not args.name or not args.email:
        sys.exit("transfer team NAME --email user@x")
    path = f"/teams/{urllib.parse.quote(args.name, safe='')}/transfer"
    _emit(
        _api("POST", path, body={"email": args.email}, pat_only=True),
        _out(args),
    )


def _add_output(p):
    p.add_argument(
        "-o",
        "--output",
        default="table",
        choices=("table", "json", "value", "name", "wide"),
    )


def _add_value_flags(p):
    p.add_argument("--value", help="plaintext (avoid — use --from-file/--from-env)")
    p.add_argument("--from-file", metavar="PATH", help="file or - for stdin")
    p.add_argument("--from-env", metavar="VAR")
    p.add_argument("--note")
    p.add_argument("--kind", choices=("plain", "database", "certificate", "ssh", "kv"))
    p.add_argument("--expires-days", type=int, dest="expires_days")
    p.add_argument("--clear-expires", action="store_true", dest="clear_expires")


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="secretserver",
        description="kubectl-style CLI for Sigaint Secret Server",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = p.add_subparsers(dest="cmd")

    pl = sub.add_parser("login", aliases=["configure"])
    pl.add_argument("--url")
    pl.add_argument("--token")
    pl.add_argument("--project")
    pl.set_defaults(func=cmd_login)

    pp = sub.add_parser("project")
    pp.add_argument("name", nargs="?")
    pp.set_defaults(func=cmd_project)

    pg = sub.add_parser("get")
    pg.add_argument("resource")
    pg.add_argument("name", nargs="?")
    pg.add_argument("-l", "--selector", dest="selector")
    pg.add_argument("--team")
    pg.add_argument("--source", choices=("org", "secret", "access", "project"))
    pg.add_argument("--status", choices=("pending", "approved", "denied", "all"))
    pg.add_argument("--actor")
    pg.add_argument("--action")
    pg.add_argument("--since")
    pg.add_argument("--until")
    pg.add_argument("--admin", action="store_true")
    _add_output(pg)
    pg.set_defaults(func=cmd_get)

    prv = sub.add_parser("reveal")
    prv.add_argument("resource", nargs="?", default="secret")
    prv.add_argument("name", nargs="?")
    prv.add_argument("--reason", default="")
    _add_output(prv)
    prv.set_defaults(func=cmd_reveal)

    pap = sub.add_parser("approve")
    pap.add_argument("request_id", nargs="?")
    pap.add_argument("name", nargs="?")
    pap.add_argument("--minutes", type=int, default=15,
                    help="grant duration: 15, 60, 240, or 1440")
    _add_output(pap)
    pap.set_defaults(func=cmd_approve)

    pdy = sub.add_parser("deny")
    pdy.add_argument("request_id", nargs="?")
    pdy.add_argument("name", nargs="?")
    _add_output(pdy)
    pdy.set_defaults(func=cmd_deny)

    pd = sub.add_parser("delete")
    pd.add_argument("resource")
    pd.add_argument("name", nargs="?")
    pd.add_argument("--team")
    _add_output(pd)
    pd.set_defaults(func=cmd_delete)

    pc = sub.add_parser("create")
    pc.add_argument("resource")
    pc.add_argument("name", nargs="?")
    pc.add_argument("--team")
    pc.add_argument("--role")
    pc.add_argument("--email")
    _add_value_flags(pc)
    _add_output(pc)
    pc.set_defaults(func=cmd_create)

    for alias in ("apply", "set"):
        pa = sub.add_parser(alias)
        pa.add_argument("resource")
        pa.add_argument("name", nargs="?")
        _add_value_flags(pa)
        _add_output(pa)
        pa.set_defaults(func=cmd_apply)

    pr = sub.add_parser("restore")
    pr.add_argument("resource")
    pr.add_argument("name", nargs="?")
    _add_output(pr)
    pr.set_defaults(func=cmd_restore)

    pt = sub.add_parser("transfer")
    pt.add_argument("resource")
    pt.add_argument("name", nargs="?")
    pt.add_argument("--email", required=True)
    _add_output(pt)
    pt.set_defaults(func=cmd_transfer)

    ph = sub.add_parser("help")
    ph.set_defaults(func=lambda _a: print(USAGE, end=""))
    return p


def main(argv: list[str] | None = None) -> None:
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] in ("-h", "--help"):
        print(USAGE, end="")
        sys.exit(0)
    p = build_parser()
    args = p.parse_args(argv)
    if not getattr(args, "func", None):
        print(USAGE, end="")
        sys.exit(0)
    args.func(args)


if __name__ == "__main__":
    main()
