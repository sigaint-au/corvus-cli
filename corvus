def cmd_export(args: argparse.Namespace) -> None:
    """export [PROJECT] -o env|value|json|csv  (PAT; defaults to current project)"""
    _require_pat()
    out = _out(args)
    proj = (args.name or "").strip() or None
    data = _mgmt_proj_api("GET", "/export", query={"mode": "plain"}, project=proj)
    items = (data or {}).get("items") or []
    if out == "json":
        _print_json(data)
        return
    if out == "csv":
        _print_table(["KEY", "VALUE"], [[it.get("key", ""), it.get("value", "")] for it in items])
        return
    if out in ("value", "env"):
        for it in items:
            sys.stdout.write(f"{it.get('key','')}={it.get('value','')}\n")
        return
    _print_table(["KEY", "NOTE"], [[it.get("key", ""), it.get("note", "")] for it in items])


