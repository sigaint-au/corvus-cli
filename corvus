def cmd_login(args: argparse.Namespace) -> None:
    url = (args.url or _env_first(ENV_URL) or "").rstrip("/")
    token = args.token or _env_first(ENV_TOKEN) or ""
    project = args.project or _env_first(*ENV_PROJECT_ALIASES) or ""
    if not (url and token and project):
        sys.exit("login needs --url, --token, and --project")
    kind = _token_kind(token)
    if kind == "unknown":
        sys.exit("token must be ss_… or pat_…")
    if kind == "machine" and not _UUID_RE.match(project):
        sys.exit("machine tokens require project UUID")
    if args.token:
        print(
            "warning: --token is visible in process listings; "
            "prefer SS_TOKEN env var",
            file=sys.stderr,
        )
    if kind == "pat":
        project = _resolve_project_if_needed(url, token, project)
    # Validate before saving so a failed login does not write a bad config.
    try:
        _http(
            "GET",
            f"{url.rstrip('/')}/eso/v1/projects/{urllib.parse.quote(project, safe='')}/secrets",
            token=token,
            query={"meta": "1"},
        )
    except SystemExit as e:
        sys.exit(f"login check failed: {e}")
    _save_config(url, token, project)
    print(f"ok: {kind} project={project}", file=sys.stderr)


def cmd_project(args: argparse.Namespace) -> None:
    name = (args.name or "").strip()
    if not name:
        c = _load_config()
        pid = c.get("project") or ""
        if not pid:
            sys.exit("no project set")
        _print_table(["PROJECT"], [[pid]])
        return
    fc = _file_config()
    url = (fc.get("url") or _env_first(ENV_URL) or "").rstrip("/")
    token = fc.get("token") or _env_first(ENV_TOKEN) or ""
    if not url or not token:
        sys.exit("login first")
    kind = _token_kind(token)
    if kind == "machine":
        if not _UUID_RE.match(name):
            sys.exit("machine tokens need project UUID")
        project = name
    else:
        project = _resolve_project_if_needed(url, token, name)
    # Validate before saving.
    try:
        _http(
            "GET",
            f"{url.rstrip('/')}/eso/v1/projects/{urllib.parse.quote(project, safe='')}/secrets",
            token=token,
            query={"meta": "1"},
        )
    except SystemExit as e:
        sys.exit(f"project switch check failed: {e}")
    _save_config(url, token, project)
    _print_table(["PROJECT", "ID"], [[name, project]])


def cmd_get(args: argparse.Namespace) -> None:
    res = (args.resource or "").lower()
    out = _out(args)
    name = args.name
    team = getattr(args, "team", None)
    q = getattr(args, "selector", None)

    if res in ("secrets",):
        _emit(_proj_api("GET", "/secrets", query={"meta": "1", "q": q}), out)
        return
    if res in ("secret",) and name:
        key = urllib.parse.quote(name, safe="/")
        try:
            _emit(_proj_api("GET", f"/secrets/{key}"), out)
        except SystemExit as e:
            msg = str(e)
            low = msg.lower()
            if "approval_required" in low or ("403" in msg and "approval" in low):
                sys.exit(
                    f"{msg}\n"
                    f"hint: request approval with:\n"
                    f'  corvus reveal secret {name} --reason "..."'
                )
            if "forbidden" in low or "403" in msg:
                sys.exit(
                    f"{msg}\n"
                    f"hint: you lack reveal permission on this secret "
                    f"(ACL / project role). Ask a project admin."
                )
            raise
        return
    if res in ("secret", "secrets") and not name:
        sys.exit("usage: get secrets | get secret NAME")
    if res in ("requests", "request", "access-requests"):
        status = getattr(args, "status", None) or "pending"
        data = _proj_api(
            "GET",
            "/access-requests",
            query={"status": status if status != "all" else None},
        )
        if out == "json":
            _emit(data, out)
            return
        items = (data or {}).get("items") or []
        if not items:
            print("(empty)")
            return
        _print_table(
            ["ID", "REQUESTER", "SECRET", "REASON", "STATUS"],
            [
                [
                    it.get("id", ""),
                    it.get("email") or it.get("name") or "",
                    it.get("secret_key", ""),
                    it.get("reason", ""),
                    it.get("status", ""),
                ]
                for it in items
            ],
        )
        return
    if res in ("projects",):
        _emit(_api("GET", "/projects", query={"q": q or name}, pat_only=True), out)
        return
    if res in ("project",) and name:
        _emit(_mgmt_api("GET", f"/projects/{urllib.parse.quote(name, safe='')}"), out)
        return
    if res in ("teams",):
        _emit(_mgmt_api("GET", "/teams", query={"q": q or name}), out)
        return
    if res in ("team",) and name:
        _emit(_mgmt_api("GET", f"/teams/{urllib.parse.quote(name, safe='')}"), out)
        return
    if res == "groups":
        if not team:
            sys.exit("get groups --team TEAM")
        _emit(_mgmt_api("GET", f"/teams/{urllib.parse.quote(team, safe='')}/groups"), out)
        return
    if res in ("members", "member"):
        if team:
            path = f"/teams/{urllib.parse.quote(team, safe='')}/members"
            _emit(_mgmt_api("GET", path), out)
        else:
            _emit(_mgmt_proj_api("GET", "/members"), out)
        return
    if res in ("tokens", "token"):
        _emit(_mgmt_proj_api("GET", "/tokens"), out)
        return
    if res in ("trash",):
        _emit(_mgmt_proj_api("GET", "/trash"), out)
        return
    if res in ("history",) and name:
        key = urllib.parse.quote(name, safe="/")
        _emit(_mgmt_proj_api("GET", f"/secrets/{key}/history"), out)
        return
    if res in ("audit",):
        source = getattr(args, "source", None) or "project"
        if source in ("org", "secret", "access") or getattr(args, "admin", False):
            if source == "project":
                source = "org"
            _emit(
                _mgmt_api(
                    "GET",
                    "/admin/audit",
                    query={
                        "source": source,
                        "q": q,
                        "actor": getattr(args, "actor", None),
                        "since": getattr(args, "since", None),
                        "until": getattr(args, "until", None),
                    },
                ),
                out,
            )
            return
        _emit(
            _mgmt_proj_api(
                "GET",
                "/audit",
                query={
                    "q": q,
                    "actor": getattr(args, "actor", None),
                    "action": getattr(args, "action", None),
                },
            ),
            out,
        )
        return
    if res in ("users", "user"):
        _emit(
            _mgmt_api("GET", "/admin/users", query={"q": q or name}),
            out,
        )
        return
    sys.exit(f"unknown resource {res!r}")


def cmd_delete(args: argparse.Namespace) -> None:
    res = (args.resource or "").lower()
    name = args.name
    out = _out(args)
    team = getattr(args, "team", None)
    if res in ("secret", "secrets"):
        if not name:
            sys.exit("delete secret NAME")
        key = urllib.parse.quote(name, safe="/")
        data = _proj_api("DELETE", f"/secrets/{key}")
        if isinstance(data, dict):
            data = {k: v for k, v in data.items() if k != "value"}
        _emit(data, out)
        return
    if res in ("team", "teams"):
        if not name:
            sys.exit("delete team NAME")
        _emit(
            _mgmt_api("DELETE", f"/teams/{urllib.parse.quote(name, safe='')}"),
            out,
        )
        return
    if res in ("project", "projects"):
        if not name:
            sys.exit("delete project NAME")
        _emit(
            _mgmt_api("DELETE", f"/projects/{urllib.parse.quote(name, safe='')}"),
            out,
        )
        return
    if res == "group":
        if not name or not team:
            sys.exit("delete group NAME --team TEAM")
        _emit(
            _mgmt_api("DELETE", f"/teams/{urllib.parse.quote(team, safe='')}/groups/{urllib.parse.quote(name, safe='')}"),
            out,
        )
        return
    if res == "group-member":
        cmd_group_member(args, remove=True)
        return
    if res in ("member", "members"):
        if not name:
            sys.exit("delete member EMAIL [--team T]")
        if team:
            path = f"/teams/{urllib.parse.quote(team, safe='')}/members/{urllib.parse.quote(name, safe='')}"
            _emit(_mgmt_api("DELETE", path), out)
        else:
            _emit(_mgmt_proj_api("DELETE", f"/members/{urllib.parse.quote(name, safe='')}"), out)
        return
    if res in ("token", "tokens"):
        if not name:
            sys.exit("delete token TOKEN_ID")
        _emit(_mgmt_proj_api("DELETE", f"/tokens/{urllib.parse.quote(name, safe='')}"), out)
        return
    if res in ("trash",):
        if getattr(args, "all", False):
            _require_pat()
            _emit(
                _mgmt_proj_api("POST", "/trash/restore", body={"action": "purge"}),
                out,
            )
            return
        if not name:
            sys.exit("delete trash SECRET_ID  (permanent purge)")
        _emit(_mgmt_proj_api("DELETE", f"/trash/{urllib.parse.quote(name, safe='')}"), out)
        return
    sys.exit(f"cannot delete {res!r}")


# Server RBAC role names (app/routes/mgmt_api). Mirrors server validation.
_TEAM_ROLES = ("team-viewer", "team-member", "team-admin", "team-owner")
_PROJECT_ROLES = ("project-read", "project-write", "project-admin")
_SERVICE_ROLES = ("service-read", "service-reveal", "service-write")


def _valid_role(role: str | None, default: str, allowed: tuple[str, ...]) -> str:
    role = (role or default).strip()
    if role not in allowed:
        sys.exit(f"role must be one of: {', '.join(allowed)} (got {role!r})")
    return role


def cmd_create(args: argparse.Namespace) -> None:
    res = (args.resource or "").lower()
    name = args.name
    out = _out(args)
    team = getattr(args, "team", None)
    role = getattr(args, "role", None)
    email = getattr(args, "email", None)

    if res in ("team", "teams"):
        if not name:
            sys.exit("create team NAME")
        _emit(_mgmt_api("POST", "/teams", body={"name": name}), out)
        return
    if res == "group":
        if not name or not team:
            sys.exit("create group NAME --team TEAM")
        body = {"name": name}
        if getattr(args, "source", None):
            body["source"] = args.source
        if getattr(args, "external_key", None):
            body["external_key"] = args.external_key
        _emit(
            _mgmt_api("POST", f"/teams/{urllib.parse.quote(team, safe='')}/groups", body=body),
            out,
        )
        return
    if res == "group-member":
        cmd_group_member(args, remove=False)
        return
    if res in ("project", "projects"):
        if not name or not team:
            sys.exit("create project NAME --team TEAM")
        path = f"/teams/{urllib.parse.quote(team, safe='')}/projects"
        _emit(_mgmt_api("POST", path, body={"name": name}), out)
        return
    if res in ("member", "members"):
        # name is email
        email = name or email
        if not email:
            sys.exit("create member EMAIL --role ROLE [--team T]")
        if team:
            role = _valid_role(role, "team-member", _TEAM_ROLES)
            _emit(_mgmt_api("POST", f"/teams/{urllib.parse.quote(team, safe='')}/members",
                            body={"email": email, "role": role}), out)
        else:
            role = _valid_role(role, "project-read", _PROJECT_ROLES)
            _emit(_mgmt_proj_api("POST", "/members",
                                 body={"email": email, "role": role}), out)
        return
    if res in ("token", "tokens"):
        role = _valid_role(role, "service-reveal", _SERVICE_ROLES)
        body = {
            "name": name or "cli",
            "role": role,
        }
        if getattr(args, "expires_days", None) is not None:
            body["expires_days"] = args.expires_days
        scope = getattr(args, "scope", None)
        if scope:
            # comma- or space-separated exact keys and/or globs ("" = all)
            keys = [k for k in re.split(r"[\s,]+", scope) if k]
            body["scope"] = keys
        data = _mgmt_proj_api("POST", "/tokens", body=body)
        # always show raw token once
        if isinstance(data, dict) and data.get("token"):
            extra = ""
            if body.get("scope"):
                extra = f" scope={','.join(body['scope'])}"
            print(f"token (copy now): {data['token']}{extra}", file=sys.stderr)
        _emit(data, out)
        return
    if res in ("secret", "secrets"):
        # delegate to apply
        args.resource = "secret"
        cmd_apply(args)
        return
    sys.exit(f"cannot create {res!r}")


def cmd_apply(args: argparse.Namespace) -> None:
    res = (args.resource or "").lower()
    if res not in ("secret", "secrets"):
        sys.exit("apply secret NAME …")
    if not args.name:
        sys.exit("apply secret NAME …")
    key = urllib.parse.quote(args.name, safe="/")

    meta_sets = _parse_meta_flags(getattr(args, "meta", None) or [])
    meta_dels = getattr(args, "delete_meta", None) or []
    if meta_sets or meta_dels:
        _require_pat()  # metadata lives on /api/v1/manage (PAT only)

    body: dict = {}
    value = _read_secret_value(args)
    if value is not None:
        if getattr(args, "value", None) is not None:
            print(
                "warning: --value is visible in process listings; "
                "use --from-file or --from-env instead",
                file=sys.stderr,
            )
        body["value"] = value
    if getattr(args, "note", None) is not None:
        body["note"] = args.note
    if getattr(args, "kind", None) is not None:
        body["kind"] = args.kind
    if getattr(args, "expires_days", None) is not None:
        body["expires_days"] = args.expires_days
    if getattr(args, "clear_expires", False):
        body["clear_expires"] = True

    access_body: dict = {}
    if getattr(args, "access_mode", None):
        access_body["access_mode"] = args.access_mode
    if getattr(args, "requires_approval", None):
        access_body["requires_approval"] = {
            "on": True, "off": False, "inherit": None,
        }[args.requires_approval]
    if access_body:
        _require_pat()  # access settings on /api/v1/manage (PAT only)

    data: dict = {}
    if body:
        method = "PUT" if "value" in body else "PATCH"
        data = _proj_api(method, f"/secrets/{key}", body=body)
    elif not meta_sets and not meta_dels and not access_body:
        sys.exit("nothing to apply")

    out = _out(args)
    if out == "value" and isinstance(data, dict) and "value" in data:
        _emit(data, "value")
        return
    for mkey, mval in meta_sets:
        _mgmt_proj_api("PATCH", f"/secrets/{key}/meta",
                       body={"key": mkey, "value": mval})
    for mkey in meta_dels:
        _mgmt_proj_api(
            "DELETE", f"/secrets/{key}/meta/{urllib.parse.quote(mkey, safe='')}"
        )
    if access_body:
        _mgmt_proj_api("PATCH", f"/secrets/{key}", body=access_body)
    if isinstance(data, dict):
        data = {k: v for k, v in data.items() if k != "value"}
        data["ok"] = data.get("ok", True)
        data["key"] = data.get("key") or args.name
    elif (meta_sets or meta_dels or access_body):
        data = {"ok": True, "key": args.name}
    _emit(data, out)


