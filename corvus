def _env_first(*names: str) -> str:
    for n in names:
        v = os.environ.get(n)
        if v:
            return v
    return ""


def _load_config() -> dict[str, str]:
    cfg = ConfigParser()
    if CONFIG_PATH.is_file():
        cfg.read(CONFIG_PATH)
    sec = cfg["default"] if cfg.has_section("default") else {}
    return {
        "url": _env_first(ENV_URL) or sec.get("url", ""),
        "token": _env_first(ENV_TOKEN) or sec.get("token", ""),
        "project": _env_first(*ENV_PROJECT_ALIASES) or sec.get("project", ""),
    }


def _file_config() -> dict[str, str]:
    cfg = ConfigParser()
    if CONFIG_PATH.is_file():
        cfg.read(CONFIG_PATH)
    sec = cfg["default"] if cfg.has_section("default") else {}
    return {
        "url": sec.get("url", ""),
        "token": sec.get("token", ""),
        "project": sec.get("project", ""),
    }


def _save_config(url: str, token: str, project: str) -> None:
    CONFIG_DIR.mkdir(parents=True, mode=0o700, exist_ok=True)
    cfg = ConfigParser()
    cfg["default"] = {"url": url.rstrip("/"), "token": token, "project": project}
    with open(CONFIG_PATH, "w") as f:
        cfg.write(f)
    CONFIG_PATH.chmod(0o600)


def _token_kind(token: str) -> str:
    if token.startswith("ss_"):
        return "machine"
    if token.startswith("pat_"):
        return "pat"
    return "unknown"


def _require_creds() -> tuple[str, str, str, str]:
    c = _load_config()
    missing = [k for k in ("url", "token") if not c.get(k)]
    if missing:
        sys.exit(
            f"missing {', '.join(missing)}; set env or run: corvus login"
        )
    kind = _token_kind(c["token"])
    if kind == "unknown":
        sys.exit("token must start with ss_… or pat_…")
    return c["url"].rstrip("/"), c["token"], c.get("project") or "", kind


def _require_project() -> str:
    _, _, project, kind = _require_creds()
    if not project:
        sys.exit("no project set; run: corvus project <name> or login --project …")
    if kind == "machine" and not _UUID_RE.match(project):
        sys.exit("machine tokens require project UUID")
    return project


def _require_pat() -> tuple[str, str]:
    base, token, _, kind = _require_creds()
    if kind != "pat":
        sys.exit("this command requires a pat_… token")
    return base, token


def _http_timeout() -> int:
    """Return the HTTP timeout from SS_TIMEOUT env var (default 60)."""
    try:
        return max(5, int(os.environ.get("SS_TIMEOUT", "60")))
    except (TypeError, ValueError):
        return 60


def _http(
    method: str,
    url: str,
    *,
    token: str,
    body: dict | None = None,
    query: dict | None = None,
) -> object:
    if query:
        url += "?" + urllib.parse.urlencode(
            {k: v for k, v in query.items() if v is not None and v != ""}
        )
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(
        url,
        data=data,
        method=method,
        headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/json",
            **({"Content-Type": "application/json"} if data is not None else {}),
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=_http_timeout()) as resp:
            raw = resp.read()
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        err_body = e.read().decode(errors="replace")[:500]
        try:
            msg = json.loads(err_body).get("error", err_body)
        except json.JSONDecodeError:
            msg = err_body or e.reason
        sys.exit(f"HTTP {e.code}: {msg}")
    except urllib.error.URLError as e:
        sys.exit(f"request failed: {e.reason}")


def _api(
    method: str,
    path: str,
    *,
    body: dict | None = None,
    query: dict | None = None,
    pat_only: bool = False,
) -> object:
    """Call /eso/v1 path (absolute under base)."""
    base, token, _, kind = _require_creds()
    if pat_only and kind != "pat":
        sys.exit("this command requires a pat_… token")
    return _http(
        method, f"{base}/eso/v1{path}", token=token, body=body, query=query
    )


def _proj_api(
    method: str,
    path: str,
    *,
    body: dict | None = None,
    query: dict | None = None,
    project: str | None = None,
) -> object:
    """Call /eso/v1/projects/<project>/…"""
    base, token, conf_proj, kind = _require_creds()
    project = project or conf_proj
    if not project:
        sys.exit("no project set; corvus project <name>")
    if kind == "machine" and not _UUID_RE.match(project):
        sys.exit("machine tokens require project UUID")
    proj = urllib.parse.quote(project, safe="")
    return _http(
        method,
        f"{base}/eso/v1/projects/{proj}{path}",
        token=token,
        body=body,
        query=query,
    )


def _mgmt_api(
    method: str,
    path: str,
    *,
    body: dict | None = None,
    query: dict | None = None,
) -> object:
    """Call /api/v1/manage path (PAT only)."""
    base, token = _require_pat()
    return _http(
        method, f"{base}/api/v1/manage{path}", token=token, body=body, query=query
    )


def _mgmt_proj_api(
    method: str,
    path: str,
    *,
    body: dict | None = None,
    query: dict | None = None,
    project: str | None = None,
) -> object:
    """Call /api/v1/manage/projects/<project>/… (PAT only)."""
    base, token, conf_proj, kind = _require_creds()
    project = project or conf_proj
    if not project:
        sys.exit("no project set; corvus project <name>")
    proj = urllib.parse.quote(project, safe="")
    return _http(
        method,
        f"{base}/api/v1/manage/projects/{proj}{path}",
        token=token,
        body=body,
        query=query,
    )


def _print_json(obj: object) -> None:
    print(json.dumps(obj, indent=2, sort_keys=True, default=str))


def _print_table(headers: list[str], rows: list[list[str]]) -> None:
    cols = list(headers)
    data = [[("" if c is None else str(c)) for c in row] for row in rows]
    widths = [len(h) for h in cols]
    for row in data:
        for i, cell in enumerate(row):
            if i < len(widths):
                widths[i] = max(widths[i], min(len(cell), 48))
    print("  ".join(h.ljust(widths[i]) for i, h in enumerate(cols)))
    print("  ".join("-" * widths[i] for i in range(len(cols))))
    for row in data:
        cells = []
        for i in range(len(cols)):
            cell = row[i] if i < len(row) else ""
            if len(cell) > 48:
                cell = cell[:47] + "…"
            cells.append(cell.ljust(widths[i]))
        print("  ".join(cells))


def _trunc(s: str, n: int = 48) -> str:
    s = str(s).replace("\n", "\\n")
    return s if len(s) <= n else s[: n - 1] + "…"


def _token_scope_label(scope) -> str:
    out = []
    for s in scope or []:
        if isinstance(s, dict):
            if s.get("secret_key"):
                out.append(s["secret_key"])
            elif s.get("key_pattern"):
                out.append(s["key_pattern"])
    return ",".join(out) if out else "*"


def _emit(obj: object, output: str) -> None:
    if output == "json":
        _print_json(obj)
        return
    if not isinstance(obj, dict):
        _print_json(obj)
        return
    if output == "value":
        if "value" not in obj:
            sys.exit("no value field")
        sys.stdout.write(str(obj["value"]))
        if not str(obj["value"]).endswith("\n"):
            sys.stdout.write("\n")
        return
    if output == "name":
        print(obj.get("key") or obj.get("name") or obj.get("id") or "")
        return
    # table
    if "items" in obj:
        items = obj.get("items") or []
        if not items:
            print("(empty)")
            return
        sample = items[0] or {}
        if "email" in sample and "scope" in sample:
            _print_table(
                ["EMAIL", "TEAM", "TEAM_ROLE", "PROJECT", "PROJECT_ROLE"],
                [
                    [
                        it.get("email", ""),
                        it.get("team", ""),
                        it.get("team_role", ""),
                        it.get("project", ""),
                        it.get("project_role", ""),
                    ]
                    for it in items
                ],
            )
        elif "email" in sample and "is_global_admin" in sample:
            _print_table(
                ["EMAIL", "NAME", "ADMIN", "DISABLED"],
                [
                    [
                        it.get("email", ""),
                        it.get("name", ""),
                        str(bool(it.get("is_global_admin"))),
                        "yes" if it.get("disabled_at") else "",
                    ]
                    for it in items
                ],
            )
        elif "team_name" in sample and "name" in sample:
            _print_table(
                ["NAME", "TEAM", "ID"],
                [
                    [it.get("name", ""), it.get("team_name", ""), it.get("id", "")]
                    for it in items
                ],
            )
        elif "token_prefix" in sample:
            _print_table(
                ["NAME", "PREFIX", "ROLE", "SCOPE", "EXPIRES", "ID"],
                [
                    [
                        it.get("name", ""),
                        it.get("token_prefix", ""),
                        it.get("role", ""),
                        _token_scope_label(it.get("scope")),
                        it.get("expires_at") or "",
                        it.get("id", ""),
                    ]
                    for it in items
                ],
            )
        elif "project_count" in sample or (
            "role" in sample and "name" in sample and "email" not in sample
        ):
            _print_table(
                ["NAME", "ROLE", "PROJECTS", "ID"],
                [
                    [
                        it.get("name", ""),
                        it.get("role", ""),
                        str(it.get("project_count", "")),
                        it.get("id", ""),
                    ]
                    for it in items
                ],
            )
        elif "secret_key" in sample or "action" in sample:
            _print_table(
                ["WHEN", "ACTION", "ACTOR", "DETAIL"],
                [
                    [
                        it.get("created_at") or it.get("when_display") or "",
                        it.get("action", ""),
                        it.get("actor_email", ""),
                        it.get("secret_key")
                        or it.get("detail")
                        or it.get("summary")
                        or "",
                    ]
                    for it in items
                ],
            )
        elif "key" in sample:
            _print_table(
                ["KEY", "KIND", "NOTE", "EXPIRES"],
                [
                    [
                        it.get("key", ""),
                        it.get("kind", ""),
                        it.get("note", ""),
                        it.get("expires_at") or it.get("deleted_at") or "",
                    ]
                    for it in items
                ],
            )
        elif "email" in sample:
            _print_table(
                ["EMAIL", "NAME", "ROLE", "USER_ID"],
                [
                    [
                        it.get("email", ""),
                        it.get("name", ""),
                        it.get("role", ""),
                        it.get("user_id", ""),
                    ]
                    for it in items
                ],
            )
        else:
            # generic keys from first row
            keys = list(sample.keys())[:6]
            _print_table(
                [k.upper() for k in keys],
                [[str(it.get(k, "")) for k in keys] for it in items],
            )
        return
    # single object → field table
    rows = []
    for k, v in obj.items():
        if k == "value" and output == "table":
            v = _trunc(str(v), 64)
        if k == "token":
            # show once fully
            rows.append([k, str(v)])
        elif v is not None and not isinstance(v, (list, dict)):
            rows.append([k, str(v)])
    if rows:
        _print_table(["FIELD", "VALUE"], rows)
    else:
        _print_json(obj)


def _out(args) -> str:
    return getattr(args, "output", None) or "table"


def _resolve_project_if_needed(url: str, token: str, project: str) -> str:
    if _UUID_RE.match(project) or not token.startswith("pat_"):
        return project
    data = _http(
        "GET",
        f"{url.rstrip('/')}/eso/v1/projects",
        token=token,
        query={"name": project},
    )
    items = (data or {}).get("items") or []
    exact = [i for i in items if i.get("name") == project]
    if len(exact) == 1:
        return exact[0]["id"]
    if len(items) == 1:
        return items[0]["id"]
    if not items:
        sys.exit(f"no project named {project!r}")
    sys.exit(
        "ambiguous project; candidates: "
        + ", ".join(f"{i.get('name')}={i.get('id')}" for i in items[:8])
    )


def _parse_meta_flags(flags: list[str]) -> list[tuple[str, str]]:
    out = []
    for f in flags:
        if "=" not in f:
            sys.exit(f"--meta needs KEY=VALUE (got {f!r})")
        k, _, v = f.partition("=")
        out.append((k.strip(), v))
    return out


def _read_secret_value(args: argparse.Namespace) -> str | None:
    sources = [
        args.from_file is not None,
        getattr(args, "from_env", None) is not None,
        getattr(args, "value", None) is not None,
    ]
    if sum(1 for s in sources if s) > 1:
        sys.exit("use only one of: --value, --from-file, --from-env")
    if args.from_file is not None:
        if args.from_file == "-":
            return sys.stdin.read()
        return Path(args.from_file).read_text()
    env_name = getattr(args, "from_env", None)
    if env_name is not None:
        if env_name not in os.environ:
            sys.exit(f"env {env_name!r} not set")
        return os.environ[env_name]
    if getattr(args, "value", None) is not None:
        return args.value
    return None


