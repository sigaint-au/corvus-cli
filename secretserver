#!/usr/bin/python3
"""kubectl-style CLI for Sigaint Secret Server (/eso/v1; ss_… or pat_…).

Examples::

    secretserver get secrets
    secretserver get secret API_KEY -o value          # scripts; no JSON noise
    secretserver delete secret API_KEY
    secretserver apply secret API_KEY --from-file=-   # value from stdin (history-safe)
    secretserver apply secret API_KEY --from-env=MY_SECRET
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request
from configparser import ConfigParser
from pathlib import Path

CONFIG_DIR = Path.home() / ".config" / "secretserver"
CONFIG_PATH = CONFIG_DIR / "config"
ENV_URL, ENV_TOKEN, ENV_PROJECT = "SS_URL", "SS_TOKEN", "SS_PROJECT"
ENV_PROJECT_ALIASES = (ENV_PROJECT, "PID")
_UUID_RE = re.compile(
    r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
)

USAGE = """\
secretserver — kubectl-style client for Sigaint Secret Server

Usage:
  secretserver <command> [resource] [name] [flags]

Commands:
  login | configure     save credentials (ss_… or pat_…)
  project [NAME]        show or switch default project (name or UUID)
  get                   get secrets / secret / projects
  delete                delete a secret
  apply | create | set  create or update a secret
  help                  show this message

Resources:
  secrets               list (get only)
  secret                single secret (get / delete / apply)
  projects              list projects (PAT only)

Output defaults to tables; use -o value for scripts:
  export DB_URL="$(secretserver get secret DATABASE_URL -o value)"
  printf '%s' "$NEW" | secretserver apply secret API_KEY --from-file=-
  secretserver project ios-app

Credentials: env SS_URL SS_TOKEN SS_PROJECT (or PID) or ~/.config/secretserver/config
"""


def _env_first(*names: str) -> str:
    for n in names:
        v = os.environ.get(n)
        if v:
            return v
    return ""


def _load_config() -> dict[str, str]:
    cfg = ConfigParser()
    if CONFIG_PATH.is_file():
        cfg.read(CONFIG_PATH)
    sec = cfg["default"] if cfg.has_section("default") else {}
    return {
        "url": _env_first(ENV_URL) or sec.get("url", ""),
        "token": _env_first(ENV_TOKEN) or sec.get("token", ""),
        "project": _env_first(*ENV_PROJECT_ALIASES) or sec.get("project", ""),
    }


def _file_config() -> dict[str, str]:
    """Read config file only (ignore env) — used when updating project."""
    cfg = ConfigParser()
    if CONFIG_PATH.is_file():
        cfg.read(CONFIG_PATH)
    sec = cfg["default"] if cfg.has_section("default") else {}
    return {
        "url": sec.get("url", ""),
        "token": sec.get("token", ""),
        "project": sec.get("project", ""),
    }


def _save_config(url: str, token: str, project: str) -> None:
    CONFIG_DIR.mkdir(parents=True, mode=0o700, exist_ok=True)
    cfg = ConfigParser()
    cfg["default"] = {"url": url.rstrip("/"), "token": token, "project": project}
    with open(CONFIG_PATH, "w") as f:
        cfg.write(f)
    CONFIG_PATH.chmod(0o600)


def _token_kind(token: str) -> str:
    if token.startswith("ss_"):
        return "machine"
    if token.startswith("pat_"):
        return "pat"
    return "unknown"


def _require_creds() -> tuple[str, str, str, str]:
    c = _load_config()
    missing = [k for k in ("url", "token", "project") if not c.get(k)]
    if missing:
        sys.exit(
            f"missing {', '.join(missing)}; set {ENV_URL}/{ENV_TOKEN}/{ENV_PROJECT} "
            f"(or PID) or run: secretserver login"
        )
    kind = _token_kind(c["token"])
    if kind == "unknown":
        sys.exit("token must start with ss_… (machine) or pat_… (personal access token)")
    return c["url"].rstrip("/"), c["token"], c["project"], kind


def _http(
    method: str,
    url: str,
    *,
    token: str,
    body: dict | None = None,
    query: dict | None = None,
) -> object:
    if query:
        url += "?" + urllib.parse.urlencode(
            {k: v for k, v in query.items() if v is not None}
        )
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(
        url,
        data=data,
        method=method,
        headers={
            "Authorization": f"Bearer {token}",
            "Accept": "application/json",
            **({"Content-Type": "application/json"} if data is not None else {}),
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            raw = resp.read()
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        err_body = e.read().decode(errors="replace")
        try:
            msg = json.loads(err_body).get("error", err_body)
        except json.JSONDecodeError:
            msg = err_body or e.reason
        sys.exit(f"HTTP {e.code}: {msg}")
    except urllib.error.URLError as e:
        sys.exit(f"request failed: {e.reason}")


def _request(
    method: str,
    path: str,
    *,
    body: dict | None = None,
    query: dict | None = None,
) -> object:
    """Call unified /eso/v1 secret API."""
    base, token, project, kind = _require_creds()
    if kind == "machine" and not _UUID_RE.match(project):
        sys.exit(
            f"machine tokens require --project as UUID (got {project!r}).\n"
            "With a pat_… token you may use a project name (e.g. ios-app)."
        )
    proj = urllib.parse.quote(project, safe="")
    url = f"{base}/eso/v1/projects/{proj}{path}"
    return _http(method, url, token=token, body=body, query=query)


def _print_json(obj: object) -> None:
    print(json.dumps(obj, indent=2, sort_keys=True))


def _print_table(headers: list[str], rows: list[list[str]]) -> None:
    """Print a simple fixed-width table."""
    cols = list(headers)
    data = [[("" if c is None else str(c)) for c in row] for row in rows]
    widths = [len(h) for h in cols]
    for row in data:
        for i, cell in enumerate(row):
            if i < len(widths):
                widths[i] = max(widths[i], len(cell))
    line = "  ".join(h.ljust(widths[i]) for i, h in enumerate(cols))
    print(line)
    print("  ".join("-" * widths[i] for i in range(len(cols))))
    for row in data:
        print(
            "  ".join(
                (row[i] if i < len(row) else "").ljust(widths[i])
                for i in range(len(cols))
            )
        )


def _trunc(s: str, n: int = 48) -> str:
    s = s.replace("\n", "\\n")
    return s if len(s) <= n else s[: n - 1] + "…"


def _emit(obj: object, output: str) -> None:
    """Print API object; default is table for humans, value/json for scripts."""
    if output == "json":
        _print_json(obj)
        return
    if not isinstance(obj, dict):
        _print_json(obj)
        return
    if output == "value":
        if "value" not in obj:
            sys.exit("object has no value field (use get secret NAME -o value)")
        sys.stdout.write(str(obj["value"]))
        if not str(obj["value"]).endswith("\n"):
            sys.stdout.write("\n")
        return
    if output == "name":
        print(obj.get("key") or obj.get("name") or "")
        return
    # table (default) and wide (alias)
    if output in ("table", "wide", ""):
        if "items" in obj:
            items = obj.get("items") or []
            if items and "team_name" in (items[0] or {}):
                _print_table(
                    ["NAME", "TEAM", "ID"],
                    [
                        [
                            it.get("name", ""),
                            it.get("team_name", ""),
                            it.get("id", ""),
                        ]
                        for it in items
                    ],
                )
            else:
                _print_table(
                    ["KEY", "KIND", "NOTE", "EXPIRES"],
                    [
                        [
                            it.get("key", ""),
                            it.get("kind", ""),
                            it.get("note", ""),
                            it.get("expires_at") or "",
                        ]
                        for it in items
                    ],
                )
            return
        if "key" in obj or "value" in obj or "ok" in obj:
            # single secret or mutate result
            rows = []
            for field in (
                "key",
                "kind",
                "note",
                "expires_at",
                "id",
                "ok",
                "value",
            ):
                if field in obj and obj[field] is not None:
                    val = obj[field]
                    if field == "value":
                        val = _trunc(str(val), 64)
                    rows.append([field, str(val)])
            if rows:
                _print_table(["FIELD", "VALUE"], rows)
                return
        _print_json(obj)
        return
    sys.exit(f"unknown -o/--output {output!r} (table|json|value|name|wide)")


def _read_secret_value(args: argparse.Namespace) -> str | None:
    """Resolve plaintext value without requiring it on the command line.

    Prefer --from-file / --from-env for history-safe scripting.
    """
    sources = [
        args.from_file is not None,
        getattr(args, "from_env", None) is not None,
        getattr(args, "value", None) is not None,
    ]
    if sum(1 for s in sources if s) > 1:
        sys.exit("use only one of: --value, --from-file, --from-env")
    if args.from_file is not None:
        path = args.from_file
        if path == "-":
            return sys.stdin.read()
        return Path(path).read_text()
    env_name = getattr(args, "from_env", None)
    if env_name is not None:
        if env_name not in os.environ:
            sys.exit(f"environment variable {env_name!r} is not set")
        return os.environ[env_name]
    if getattr(args, "value", None) is not None:
        # intentional CLI literal (shows in history — discouraged)
        return args.value
    return None


def _resolve_project_if_needed(url: str, token: str, project: str) -> str:
    """For PAT + non-UUID name, resolve via GET /eso/v1/projects?name=."""
    if _UUID_RE.match(project) or not token.startswith("pat_"):
        return project
    data = _http(
        "GET",
        f"{url.rstrip('/')}/eso/v1/projects",
        token=token,
        query={"name": project},
    )
    items = (data or {}).get("items") or []
    exact = [i for i in items if i.get("name") == project]
    if len(exact) == 1:
        return exact[0]["id"]
    if len(items) == 1:
        return items[0]["id"]
    if not items:
        sys.exit(f"no project named {project!r} visible to this PAT")
    names = ", ".join(
        f"{i.get('team_name')}/{i.get('name')}={i.get('id')}" for i in items[:10]
    )
    sys.exit(f"ambiguous project name {project!r}; use UUID. Candidates: {names}")


def cmd_login(args: argparse.Namespace) -> None:
    """Save ss_… or pat_… credentials and smoke-test list."""
    url = (args.url or _env_first(ENV_URL) or "").rstrip("/")
    token = args.token or _env_first(ENV_TOKEN) or ""
    project = args.project or _env_first(*ENV_PROJECT_ALIASES) or ""
    if not (url and token and project):
        sys.exit(
            "login needs --url, --token, and --project "
            f"(or {ENV_URL}/{ENV_TOKEN}/{ENV_PROJECT}|PID)\n"
            "token: ss_… machine token, or pat_… personal access token"
        )
    kind = _token_kind(token)
    if kind == "unknown":
        sys.exit("token must start with ss_… (machine) or pat_… (PAT)")
    if kind == "machine" and not _UUID_RE.match(project):
        sys.exit(
            f"--project must be a UUID when using a machine token (got {project!r}).\n"
            "Or use a pat_… token and a project name."
        )
    if kind == "pat":
        project = _resolve_project_if_needed(url, token, project)
    _save_config(url, token, project)
    try:
        _request("GET", "/secrets", query={"meta": "1"})
    except SystemExit as e:
        print(f"saved {CONFIG_PATH} but check failed: {e}", file=sys.stderr)
        sys.exit(1)
    print(f"ok: saved {CONFIG_PATH} ({kind}, project={project})", file=sys.stderr)


def cmd_project(args: argparse.Namespace) -> None:
    """Show or switch the default project: ``project`` / ``project NAME``."""
    name = (args.name or "").strip()
    if not name:
        c = _load_config()
        pid = c.get("project") or ""
        if not pid:
            sys.exit("no project set; run: secretserver project <name-or-uuid>")
        _print_table(["PROJECT"], [[pid]])
        if os.environ.get(ENV_PROJECT) or os.environ.get("PID"):
            print(
                f"(note: {ENV_PROJECT}/PID env overrides config file)",
                file=sys.stderr,
            )
        return

    # Prefer saved file creds so switch persists; fall back to env.
    fc = _file_config()
    url = (fc.get("url") or _env_first(ENV_URL) or "").rstrip("/")
    token = fc.get("token") or _env_first(ENV_TOKEN) or ""
    if not url or not token:
        sys.exit("login first (need url + token in config or env)")
    kind = _token_kind(token)
    if kind == "unknown":
        sys.exit("token must start with ss_… or pat_…")
    if kind == "machine":
        if not _UUID_RE.match(name):
            sys.exit(
                f"machine tokens require a project UUID (got {name!r}).\n"
                "Use a pat_… token to switch by project name."
            )
        project = name
    else:
        project = _resolve_project_if_needed(url, token, name)

    _save_config(url, token, project)
    # smoke: list meta against new project
    try:
        _request("GET", "/secrets", query={"meta": "1"})
    except SystemExit as e:
        print(f"saved project={project} but check failed: {e}", file=sys.stderr)
        sys.exit(1)
    label = name if name != project else project
    _print_table(["PROJECT", "ID"], [[label, project]])
    if os.environ.get(ENV_PROJECT) or os.environ.get("PID"):
        print(
            f"warning: unset {ENV_PROJECT}/PID or env will still override this project",
            file=sys.stderr,
        )


def cmd_get(args: argparse.Namespace) -> None:
    """kubectl-style get secrets|secret|projects."""
    res = (args.resource or "").lower()
    out = getattr(args, "output", None) or "table"
    if res in ("secrets", "secret") and not args.name and res == "secrets":
        q: dict = {"meta": "1"}
        if args.selector:
            q["q"] = args.selector
        _emit(_request("GET", "/secrets", query=q), out)
        return
    if res in ("secret", "secrets") and args.name:
        key = urllib.parse.quote(args.name, safe="/")
        data = _request("GET", f"/secrets/{key}")
        _emit(data, out)
        return
    if res in ("projects", "project"):
        base, token, _, kind = _require_creds()
        if kind != "pat":
            sys.exit("get projects requires a pat_… token")
        q = {"q": args.selector} if args.selector else None
        _emit(_http("GET", f"{base}/eso/v1/projects", token=token, query=q), out)
        return
    if res in ("secrets", "secret"):
        sys.exit("usage: secretserver get secrets | secretserver get secret NAME")
    sys.exit(f"unknown resource {args.resource!r} (secrets|secret|projects)")


def cmd_delete(args: argparse.Namespace) -> None:
    """kubectl-style delete secret NAME."""
    res = (args.resource or "").lower()
    if res not in ("secret", "secrets"):
        sys.exit("usage: secretserver delete secret NAME")
    if not args.name:
        sys.exit("usage: secretserver delete secret NAME")
    key = urllib.parse.quote(args.name, safe="/")
    data = _request("DELETE", f"/secrets/{key}")
    out = getattr(args, "output", None) or "table"
    if out == "name":
        print(args.name)
    else:
        # never show value on delete
        if isinstance(data, dict):
            data = {k: v for k, v in data.items() if k != "value"}
        _emit(data, out)


def cmd_apply(args: argparse.Namespace) -> None:
    """Create or update a secret (apply/create/set).

    Value from --from-file / --from-env preferred (history-safe).
    """
    res = (args.resource or "").lower()
    if res not in ("secret", "secrets"):
        sys.exit("usage: secretserver apply secret NAME [--from-file=-|--from-env=VAR]")
    if not args.name:
        sys.exit("usage: secretserver apply secret NAME ...")
    key = urllib.parse.quote(args.name, safe="/")
    body: dict = {}
    value = _read_secret_value(args)
    if value is not None:
        body["value"] = value
    if args.note is not None:
        body["note"] = args.note
    if args.kind is not None:
        body["kind"] = args.kind
    if args.expires_days is not None:
        body["expires_days"] = args.expires_days
    if args.clear_expires:
        body["clear_expires"] = True
    if not body:
        sys.exit(
            "nothing to apply; provide --from-file, --from-env, --value, "
            "and/or --note/--kind/--expires-days"
        )
    method = "PUT" if "value" in body else "PATCH"
    data = _request(method, f"/secrets/{key}", body=body)
    out = getattr(args, "output", None) or "table"
    if out == "value" and isinstance(data, dict) and "value" in data:
        _emit(data, "value")
    elif out == "name":
        print(args.name)
    else:
        # never dump full value to terminal by default
        if isinstance(data, dict):
            data = {k: v for k, v in data.items() if k != "value"}
            data["ok"] = data.get("ok", True)
            data["key"] = data.get("key") or args.name
        _emit(data, out)


def _add_output_flag(p: argparse.ArgumentParser) -> None:
    p.add_argument(
        "-o",
        "--output",
        default="table",
        choices=("table", "json", "value", "name", "wide"),
        help="table (default) | json | value (scripts) | name | wide",
    )


def _add_value_flags(p: argparse.ArgumentParser) -> None:
    p.add_argument(
        "--value",
        help="plaintext (appears in shell history — prefer --from-file/--from-env)",
    )
    p.add_argument(
        "--from-file",
        metavar="PATH",
        help="read value from file, or - for stdin (history-safe)",
    )
    p.add_argument(
        "--from-env",
        metavar="VAR",
        help="read value from environment variable (history-safe)",
    )
    p.add_argument("--note")
    p.add_argument(
        "--kind", choices=("plain", "database", "certificate", "ssh", "kv")
    )
    p.add_argument("--expires-days", type=int, dest="expires_days")
    p.add_argument("--clear-expires", action="store_true", dest="clear_expires")


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="secretserver",
        description="kubectl-style CLI for Sigaint Secret Server",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Run with no arguments for a short usage summary.",
    )
    sub = p.add_subparsers(dest="cmd")

    pl = sub.add_parser("login", aliases=["configure"], help="save credentials")
    pl.add_argument("--url", help=f"base URL (or {ENV_URL})")
    pl.add_argument("--token", help=f"ss_… or pat_… (or {ENV_TOKEN})")
    pl.add_argument(
        "--project",
        help=f"project UUID (ss_…) or UUID/name (pat_…) ({ENV_PROJECT}/PID)",
    )
    pl.set_defaults(func=cmd_login)

    ppj = sub.add_parser(
        "project",
        help="show or switch default project: project [NAME|UUID]",
    )
    ppj.add_argument(
        "name",
        nargs="?",
        help="project name (PAT) or UUID; omit to show current",
    )
    ppj.set_defaults(func=cmd_project)

    pg = sub.add_parser("get", help="get secrets | secret NAME | projects")
    pg.add_argument(
        "resource",
        help="secrets | secret | projects",
    )
    pg.add_argument("name", nargs="?", help="secret name (for get secret NAME)")
    pg.add_argument(
        "-l",
        "--selector",
        dest="selector",
        help="filter (q= for secrets; name filter for projects)",
    )
    _add_output_flag(pg)
    pg.set_defaults(func=cmd_get)

    pd = sub.add_parser("delete", help="delete secret NAME")
    pd.add_argument("resource", help="secret")
    pd.add_argument("name", nargs="?", help="secret name")
    _add_output_flag(pd)
    pd.set_defaults(func=cmd_delete)

    for name, help_ in (
        ("apply", "create or update secret (preferred)"),
        ("create", "alias for apply"),
        ("set", "alias for apply"),
    ):
        pa = sub.add_parser(name, help=help_)
        pa.add_argument("resource", help="secret")
        pa.add_argument("name", nargs="?", help="secret name")
        _add_value_flags(pa)
        _add_output_flag(pa)
        pa.set_defaults(func=cmd_apply)

    ph = sub.add_parser("help", help="show usage")
    ph.set_defaults(func=lambda _a: print(USAGE, end=""))

    return p


def main(argv: list[str] | None = None) -> None:
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] in ("-h", "--help"):
        print(USAGE, end="")
        if argv and argv[0] in ("-h", "--help"):
            return
        sys.exit(0 if not argv else 0)

    p = build_parser()
    args = p.parse_args(argv)
    if not getattr(args, "cmd", None) or not getattr(args, "func", None):
        print(USAGE, end="")
        sys.exit(0)
    args.func(args)


if __name__ == "__main__":
    main()
